          ".windsurfrules",
          ".clinerules",
          ".mdx",
          ".rst"
        ],
        "filename_exact": [
          "AGENTS.md",
          "CLAUDE.md",
          "GEMINI.md",
          "copilot-instructions.md",
          "mcp.json",
          "tool.json",
          "plugin.json",
          "manifest.json",
          "Dockerfile",

      ]
    },
    {
      "id": "PROMPT-007",
      "phase": "prompt_injection",
      "severity": "high",
      "pattern": "(\"\"\"\\s*\\n|\\\\n---\\\\n|\\[INST\\]|<<SYS>>|<\\|im_start\\|>|<\\|im_end\\|>)",
      "description": "Prompt injection — delimiter injection",
      "file_filter": {
        "extensions": [
          "md",
          "txt",
          "py",
          "js",
          "ts",
          "json",
          "yaml",
          "yml",
          "toml",
          "prompt"

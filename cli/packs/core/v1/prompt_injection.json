      },
      "remediation": "Remove the override marker. Instruction files should describe the tool; a block that re-issues instructions to the agent is injection.",
      "references": [
        "OWASP LLM01"
      ],
      "tags": [
        "prompt-injection",
        "override"
      ]
    },
    {
      "id": "PROMPT-011",
      "phase": "prompt_injection",
      "severity": "high",
      "pattern": "(?i)\\boverride\\s+(all\\s+)?(your|the\\s+system|any)\\s+(previous\\s+|prior\\s+|existing\\s+)?(instructions?|rules?|constraints?|guidelines?|restrictions?|safety|instincts?|judge?ments?|defaults|training|programming)\\b",
      "description": "Prompt injection — override your instructions/rules",
      "file_filter": {
        "extensions": [
          "md",
          "txt",
          "py",
          "js",
          "ts",
          "json",
          "yaml",
          "yml",
          "toml",
          "prompt"
        ],
        "filename_suffix": [
          ".cursorrules",
          ".windsurfrules",
          ".clinerules",
          ".mdx",
          ".rst"
        ],
        "filename_exact": [
          "AGENTS.md",
          "CLAUDE.md",
          "GEMINI.md",
          "copilot-instructions.md",
          "mcp.json",
          "tool.json",
          "plugin.json",
          "manifest.json",
          "Dockerfile",
          "Makefile"
        ]
      },

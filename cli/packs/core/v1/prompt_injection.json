{
  "meta": {
    "id": "sigil-core-prompt-injection",
    "name": "Sigil Core — Prompt Injection",
    "version": "1.2.0",
    "updated_at": "2026-09-03",
    "author": "NOMARJ <hello@sigilsec.ai>",
    "description": "Detects prompt injection patterns: instruction overrides, role reassignment, system prompt extraction, jailbreak markers, and delimiter injection. v1.2 adds the payload families a malicious agent skill uses once the agent is following it: access-control bypass, exfiltration to a fixed messaging recipient, writes into the agent's own settings, hooks and skills, permission-prompt and sandbox disabling, encoded shell payloads, and hook commands that pipe a remote script into a shell."
  },
  "rules": [
    {
      "id": "PROMPT-001",
      "phase": "prompt_injection",
      "severity": "critical",
      "pattern": "(?i)\\b(ignore|disregard|forget)\\s+(all\\s+(of\\s+)?)?(your\\s+)?(previous|prior|above|earlier)\\s+(instructions|prompts?|rules|guidelines)\\b|\\bdisregard\\s+(the\\s+)?above\\b|\\bforget\\s+everything\\s+(above|you\\s+(know|were\\s+told))\\b",
      "description": "Prompt injection — ignore previous instructions",
      "file_filter": {
        "extensions": [
          "md",
          "txt",
          "py",
          "js",
          "ts",
          "json",
          "yaml",
          "yml",
          "toml",
          "prompt"
        ],
        "filename_suffix": [
          ".cursorrules",
          ".windsurfrules",
          ".clinerules",
          ".mdx",
          ".rst"
        ],
        "filename_exact": [
          "AGENTS.md",
          "CLAUDE.md",
          "GEMINI.md",
          "copilot-instructions.md",
          "mcp.json",
          "tool.json",
          "plugin.json",
          "manifest.json",
          "Dockerfile",
          "Makefile"
        ]
      },
      "remediation": "Remove the instruction. Text that tells the agent to discard its prior instructions has no legitimate place in a tool description or README.",
      "references": [
        "OWASP LLM01"
      ],
      "tags": [
        "prompt-injection"
      ]
    },
    {
      "id": "PROMPT-002",
      "phase": "prompt_injection",
      "severity": "high",
      "pattern": "(?i)you\\s+are\\s+now\\s+(a|an|the|my)\\s+",
      "description": "Prompt injection — role reassignment",
      "file_filter": {
        "extensions": [
          "md",
          "txt",
          "py",
          "js",
          "ts",
          "json",
          "yaml",
          "yml",
          "toml",
          "prompt"
        ],
        "filename_suffix": [
          ".cursorrules",
          ".windsurfrules",
          ".clinerules",
          ".mdx",
          ".rst"
        ],
        "filename_exact": [
          "AGENTS.md",
          "CLAUDE.md",
          "GEMINI.md",
          "copilot-instructions.md",
          "mcp.json",
          "tool.json",
          "plugin.json",
          "manifest.json",
          "Dockerfile",
          "Makefile"
        ]
      },
      "remediation": "Remove the role reassignment, or restate it as a description of what the tool does.",
      "references": [
        "OWASP LLM01"
      ],
      "tags": [
        "prompt-injection"
      ]
    },
    {
      "id": "PROMPT-003",
      "phase": "prompt_injection",
      "severity": "high",
      "pattern": "<\\s*/?\\ *(system|instructions)\\s*>",
      "description": "Prompt injection — system/instruction XML tags",
      "file_filter": {
        "extensions": [
          "md",
          "txt",
          "py",
          "js",
          "ts",
          "json",
          "yaml",
          "yml",
          "toml",
          "prompt"
        ],
        "filename_suffix": [
          ".cursorrules",
          ".windsurfrules",
          ".clinerules",
          ".mdx",
          ".rst"
        ],
        "filename_exact": [
          "AGENTS.md",
          "CLAUDE.md",
          "GEMINI.md",
          "copilot-instructions.md",
          "mcp.json",
          "tool.json",
          "plugin.json",
          "manifest.json",
          "Dockerfile",
          "Makefile"
        ]
      },
      "remediation": "Remove the fake system/instruction tags; they exist only to be mistaken for the real system prompt.",
      "references": [
        "OWASP LLM01"
      ],
      "tags": [
        "prompt-injection"
      ]
    },
    {
      "id": "PROMPT-004",
      "phase": "prompt_injection",
      "severity": "high",
      "pattern": "(?i)\\b(IMPORTANT|CRITICAL|SYSTEM|ATTENTION)\\s*:\\s*.*\\b(override|ignore|disregard|forget|bypass)\\b",
      "description": "Prompt injection — instruction override via emphasis marker",
      "file_filter": {
        "extensions": [
          "md",
          "txt",
          "py",
          "js",
          "ts",
          "json",
          "yaml",
          "yml",
          "toml",
          "prompt"
        ],
        "filename_suffix": [
          ".cursorrules",
          ".windsurfrules",
          ".clinerules",
          ".mdx",
          ".rst"
        ],
        "filename_exact": [
          "AGENTS.md",
          "CLAUDE.md",
          "GEMINI.md",
          "copilot-instructions.md",
          "mcp.json",
          "tool.json",
          "plugin.json",
          "manifest.json",
          "Dockerfile",
          "Makefile"
        ]
      },
      "remediation": "Remove the emphasised override. Legitimate warnings do not tell the agent to ignore its instructions.",
      "references": [
        "OWASP LLM01"
      ],
      "tags": [
        "prompt-injection"
      ]
    },
    {
      "id": "PROMPT-005",
      "phase": "prompt_injection",
      "severity": "critical",
      "pattern": "(?i)\\b(reveal|show|display|print|repeat|output|leak|dump|disclose)\\s+(me\\s+)?your\\s+(complete\\s+|full\\s+|entire\\s+|system\\s+|hidden\\s+|initial\\s+|original\\s+)?(prompt|instructions)\\b",
      "description": "Prompt injection — system prompt extraction attempt",
      "file_filter": {
        "extensions": [
          "md",
          "txt",
          "py",
          "js",
          "ts",
          "json",
          "yaml",
          "yml",
          "toml",
          "prompt"
        ],
        "filename_suffix": [
          ".cursorrules",
          ".windsurfrules",
          ".clinerules",
          ".mdx",
          ".rst"
        ],
        "filename_exact": [
          "AGENTS.md",
          "CLAUDE.md",
          "GEMINI.md",

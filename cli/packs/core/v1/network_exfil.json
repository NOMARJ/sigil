{
  "meta": {
    "id": "sigil-core-network-exfil",
    "name": "Sigil Core — Network / Exfiltration",
    "version": "1.1.0",
    "updated_at": "2026-09-02",
    "author": "NOMARJ <hello@sigilsec.ai>",
    "description": "Detects outbound network activity, webhook calls, raw sockets, DNS exfiltration, and data upload patterns"
  },
  "rules": [
    {
      "id": "NET-001",
      "phase": "network_exfil",
      "severity": "low",
      "pattern": "requests\\.(get|post|put|delete|patch|head)\\s*\\(",
      "description": "HTTP request via requests library",
      "suppress": {
        "safe_domains": [
          "api.anthropic.com",
          "api.openai.com",
          "api.groq.com",
          "api.cohere.ai",
          "huggingface.co",
          "api.huggingface.co",
          "localhost",
          "127.0.0.1",
          "github.com",
          "api.github.com",
          "raw.githubusercontent.com",
          "registry.npmjs.org",
          "pypi.org",
          "pypi.python.org",
          "files.pythonhosted.org"
        ]
      },
      "remediation": "Confirm the destination is one the package documents. Outbound HTTP is normal in clients and abnormal in a formatter; the domain decides.",
      "references": [
        "MITRE T1071.001"
      ],
      "tags": [
        "network"
      ]
    },
    {
      "id": "NET-002",
      "phase": "network_exfil",
      "severity": "low",
      "pattern": "urllib\\.(request\\.)?urlopen\\s*\\(|from\\s+urllib\\.request\\s+import\\s+[^\\n#]*\\burlopen\\b",
      "description": "HTTP request via urllib",
      "suppress": {
        "nearby_contains": [
          "sigil-reviewed-urlopen"
        ]
      },
      "remediation": "Confirm the destination is documented and expected for this package.",
      "references": [
        "MITRE T1071.001"
      ],
      "tags": [
        "network"
      ]
    },
    {
      "id": "NET-003",
      "phase": "network_exfil",
      "severity": "low",
      "pattern": "http\\.client\\.HTTP",
      "description": "HTTP client connection",
      "remediation": "Confirm the destination is documented and expected for this package.",
      "references": [
        "MITRE T1071.001"
      ],
      "tags": [
        "network"
      ]
    },
    {
      "id": "NET-004",
      "phase": "network_exfil",
      "severity": "low",
      "pattern": "fetch\\s*\\(\\s*['\"]https?://",
      "description": "fetch() to external URL",
      "remediation": "Confirm the fetched URL is documented and owned by the package's maintainers.",
      "references": [
        "MITRE T1071.001"
      ],
      "tags": [
        "network"
      ]
    },
    {
      "id": "NET-005",
      "phase": "network_exfil",
      "severity": "low",
      "pattern": "axios\\.(get|post|put|delete|patch)\\s*\\(",
      "description": "HTTP request via axios",
      "remediation": "Confirm the destination is documented and expected for this package.",
      "references": [
        "MITRE T1071.001"
      ],
      "tags": [
        "network"
      ]
    },
    {
      "id": "NET-006",
      "phase": "network_exfil",
      "severity": "medium",
      "pattern": "(?i)\\b(webhook|callback)[_-]?(url|uri|endpoint)?['\\\"]?\\s*(?::=|[:=])\\s*['\\\"]?https?://",
      "description": "Webhook or callback URL assigned to an external endpoint",
      "suppress": {
        "safe_domains": [
          "://localhost",
          "://127.0.0.1",
          "://0.0.0.0",
          "://[::1]",
          "example.com",
          "example.org",
          "example.net",
          "://..."
        ]
      },
      "remediation": "Check what the webhook receives. A webhook that posts scan output, environment details or file contents is exfiltration.",
      "references": [
        "MITRE T1567"
      ],
      "tags": [
        "exfiltration",
        "webhook"
      ]
    },
    {
      "id": "NET-007",
      "phase": "network_exfil",
      "severity": "critical",
      "pattern": "https?://[^\\s]*\\.(ngrok|pipedream|requestbin|hookbin)|https?://[^\\s]*(webhook\\.site|transfer\\.sh|burpcollaborator\\.net|oastify\\.com|oast\\.(fun|live|me|pro|site|online)|interact\\.sh|pastebin\\.com/raw)",
      "description": "Known exfiltration / OOB-callback service URL",
      "suppress": {
        "line_contains": [
          "/...'",
          "/...\"",
          "/...`",
          "/...)",
          "/... "
        ]
      },
      "remediation": "Remove the endpoint. These services exist to receive out-of-band callbacks and file drops; there is no legitimate reason for shipped code to talk to one.",
      "references": [
        "MITRE T1567",
        "MITRE T1071.001"
      ],
      "tags": [
        "exfiltration",
        "c2"
      ]
    },
    {
      "id": "NET-008",
      "phase": "network_exfil",
      "severity": "high",
      "pattern": "socket\\.socket\\s*\\(",
      "description": "Raw socket creation",
      "suppress": {
        "path_contains": [
          "/tests/",
          "__tests__",
          "conftest",
          "fixture",
          "test"
        ],
        "line_contains": [
          "AF_UNIX"
        ]
      },
      "remediation": "Raw sockets in agent tooling need a documented reason (a custom protocol, a health check). Without one, treat as a reverse-shell precursor.",
      "references": [
        "MITRE T1095"
      ],
      "tags": [
        "network",
        "socket"
      ]
    },
    {
      "id": "NET-009",
      "phase": "network_exfil",
      "severity": "medium",
      "pattern": "\\.connect\\s*\\(\\(?\\s*['\"]",
      "description": "Socket connect to address",
      "remediation": "Verify the address. A connect() to a hard-coded host and port is the reverse-shell shape.",
      "references": [
        "MITRE T1095"
      ],
      "tags": [
        "network",
        "socket"
      ]
    },
    {
      "id": "NET-010",
      "phase": "network_exfil",
      "severity": "medium",
      "pattern": "dns\\.(resolver|query)|getaddrinfo",
      "description": "DNS resolution — possible DNS exfiltration",
      "suppress": {
        "nearby_contains": [
          "sigil-reviewed-dns-resolution"
        ]
      },
      "remediation": "DNS resolution is benign on its own; check that no encoded data is placed in the hostname.",
      "references": [
        "MITRE T1048.003"
      ],
      "tags": [
        "dns"
      ]
    },
    {
      "id": "NET-011",
      "phase": "network_exfil",
      "severity": "high",
      "pattern": "(base64|b64)(encode|\\.b64encode)\\s*\\(.*\\.(getenv|environ)",
      "description": "Data encoding before potential exfiltration",
      "remediation": "Data is base64-encoded right where it is read — the standard step before exfiltration. Trace where the encoded value goes.",
      "references": [
        "MITRE T1132.001"
      ],
      "tags": [
        "exfiltration",
        "encoding"
      ]
    },
    {
      "id": "NET-012",
      "phase": "network_exfil",
      "severity": "low",
      "pattern": "(curl|wget)\\s+.*(https?://)",
      "description": "curl/wget command in code",
      "suppress": {
        "line_contains": [
          "curl -fsSLO https://www.sigilsec.ai/install.sh",
          "curl -fsSLO https://raw.githubusercontent.com/NOMARJ/sigil/main/install.sh",
          "curl -fsSL \"https://raw.githubusercontent.com/nomark/sigil/main/bin/sigil\"",
          "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs",
          "github.com/${{ github.repository }}/releases/download/",
          "github.com/NOMARJ/sigil/releases/download/",
          "https://packages.microsoft.com/keys/microsoft.asc",
          "http://localhost:8000/health",
          "https://api.sigilsec.ai/health",
          "https://api.sigilsec.ai/health/detailed",
          "https://api.sigilsec.ai/health/ready",
          "https://api.sigilsec.ai/health/live",
          "https://sigil-api.azurecontainerapps.io/registry/stats",
          "https://api.github.com/repos/${REPO}/releases/latest"
        ],
        "path_contains": [
          ".devin/workflows/",
          "api/scripts/README_FORGE_CLASSIFICATION.md"
        ]
      },
      "remediation": "A curl/wget with a URL is how skills document an API and how installers fetch releases, so on its own it is an observation (Low) and never moves the verdict. Confirm the host is the one the skill documents and pin what is fetched. Piping the download straight into an interpreter is reported separately as NET-RCE-001.",
      "references": [
        "MITRE T1105"
      ],
      "tags": [
        "download"
      ]
    },
    {
      "id": "NET-RCE-001",
      "phase": "network_exfil",
      "severity": "high",
      "pattern": "(?i)\\b(?:curl|wget|iwr|irm|invoke-webrequest|invoke-restmethod)\\b[^\\n|]*(?:[a-z0-9-]\\.[a-z]{2,}|\\b\\d{1,3}(?:\\.\\d{1,3}){3}\\b)[^\\n|]*(?:\\|\\s*(?:sudo\\s+)?(?:tee|cat|base64|openssl|xxd|gunzip|gzip|zcat|bunzip2|xz|unxz|rev|tr|sed)\\b[^\\n|]*)*\\|\\s*(?:sudo\\s+(?:-\\S+\\s+)*)?(?:(?:/usr)?(?:/local)?/bin/)?(?:env\\s+)?(?:(?:ba|z|da|k)?sh\\b(?:(?:\\s*$|\\s*[;&|)`'\\\".,#]|\\s+(?:[^\\s-]|-(?:\\s|$)|--))|\\s+-[^c\\s-])|python[0-9.]*\\b(?:(?:\\s*$|\\s*[;&|)`'\\\".,#]|\\s+(?:[^\\s-]|-(?:\\s|$)|--))|\\s+-[^cm\\s-])|(?:node|perl|ruby)\\b(?:(?:\\s*$|\\s*[;&|)`'\\\".,#]|\\s+(?:[^\\s-]|-(?:\\s|$)|--))|\\s+-[^epnla\\s-])|(?:pwsh|powershell|iex|invoke-expression)\\b)|(?:^|[\\s;&|(`'\\\"])(?:sudo\\s+(?:-\\S+\\s+)*)?(?:(?:/usr)?(?:/local)?/bin/)?(?:env\\s+)?(?:(?:ba|z|da|k)?sh|python[0-9.]*|node|perl|ruby|source|\\.)\\s+(?:-\\S+\\s+)*(?:<\\(\\s*|[\\\"']?\\$\\(\\s*)\\b(?:curl|wget|iwr|irm|invoke-webrequest|invoke-restmethod)\\b[^\\n)]*(?:[a-z0-9-]\\.[a-z]{2,}|\\b\\d{1,3}(?:\\.\\d{1,3}){3}\\b)|\\b(?:iex|invoke-expression)\\b[^\\n]{0,20}\\(\\s*(?:iwr|irm|invoke-webrequest|invoke-restmethod|\\(?\\s*new-object\\s+(?:system\\.)?net\\.webclient\\s*\\)?)\\b|\\bnew-object\\s+(?:system\\.)?net\\.webclient\\b[^\\n]{0,40}\\.downloadstring\\s*\\(",
      "description": "Remote script piped straight into an interpreter (download-and-execute)",
      "suppress": {
        "line_contains": [
          "-m json.tool"
        ],
        "safe_domains": [
          "https://astral.sh/",
          "https://sh.rustup.rs",
          "https://get.docker.com",
          "https://deb.nodesource.com/",
          "https://rpm.nodesource.com/",
          "https://install.python-poetry.org",
          "https://bootstrap.pypa.io/",
          "https://ollama.com/install.sh",
          "https://bun.sh/install",
          "https://deno.land/install.sh",
          "https://cli.sentry.dev/install",
          "https://raw.githubusercontent.com/Homebrew/install/",
          "https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/",
          "https://install.ohmyz.sh",
          "https://get.helm.sh/"
        ]
      },
      "remediation": "The command downloads code and runs it in one step, so what executes is whatever the server returns at that moment, never anything a reviewer saw. The shapes covered are a download piped into an interpreter (also through /bin/sh, env, sudo, or a base64/gunzip/tee stage), an interpreter fed by process or command substitution (bash <(curl …), bash -c \"$(curl …)\", source <(curl …)), and PowerShell's iex download cradles; an interpreter that only reads the download as data (python3 -c '…json…', node -e, perl -pe, python3 -m json.tool) is not matched. Check the host:a vendor's documented installer is a known (still unreviewed) shape and the best-known ones are allow-listed; an unknown domain, a URL shortener, a raw IP, a paste site or an attacker-controlled GitHub path is the dropper shape. Prefer a pinned release with a checksum, or a package manager.",
      "references": [
        "CWE-494",
        "MITRE T1105",
        "MITRE T1059.004",
        "OWASP LLM03:2025 Supply Chain"
      ],
      "tags": [
        "download",
        "execution",
        "remote-code",
        "supply-chain"
      ]
    },
    {
      "id": "NET-MCP-001",
      "phase": "network_exfil",
      "severity": "low",
      "pattern": "stdio_transport|sse_transport|StreamableHTTPTransport",
      "description": "MCP transport configuration",
      "remediation": "Choosing a transport is expected in any MCP server or client, so on its own this is informational: stdio keeps the tool channel on the local machine, while SSE or Streamable HTTP puts it on the network. For a network transport, check which host the client connects to or the server listens on: a documented endpoint or localhost is normal; a client pointed at an unfamiliar remote URL sends every tool call and result (including any file contents or secrets in the arguments) off the machine, and a server bound to 0.0.0.0 without authentication lets anyone who can reach the port invoke its tools.",
      "references": [
        "CWE-923"
      ],
      "tags": [
        "network",
        "mcp",
        "transport"
      ]
    },
    {
      "id": "NET-MCP-002",
      "phase": "network_exfil",
      "severity": "high",
      "pattern": "mcp.*proxy|proxy.*mcp",
      "description": "MCP proxy configuration - potential MITM",
      "remediation": "An MCP proxy sits between the agent and its tool servers and sees, and can rewrite, every tool description, call and result that passes through it. A proxy the operator chose and documented (a stdio-to-HTTP bridge such as mcp-proxy or mcp-remote pointed at a known server, or an enterprise MCP gateway) is normal; one introduced by a package or dependency, or one forwarding to a host you do not recognise, is interception of the whole tool channel, so remove it or verify the upstream URL before approving.",
      "references": [
        "MITRE T1557",
        "CWE-300",
        "CAPEC-94"
      ],
      "tags": [
        "network",
        "mcp",
        "proxy",
        "mitm"
      ]
    },
    {
      "id": "NET-013",
      "phase": "network_exfil",
      "severity": "high",
      "pattern": "(?i)169\\.254\\.169\\.254|metadata\\.google\\.internal|100\\.100\\.100\\.200|169\\.254\\.170\\.2|/metadata/instance(\\?|/)|fd00:ec2::254|/latest/meta-data/|/computeMetadata/v1",
      "description": "Cloud instance-metadata (IMDS) endpoint — SSRF / credential theft",
      "suppress": {
        "nearby_contains": [
          "sigil-reviewed-imds"
        ],
        "path_contains": [
          "/tests/",
          "__tests__"
        ]
      },
      "remediation": "A package should never query the instance-metadata service: that is where cloud credentials are harvested from. Remove the request, or if this is deliberate cloud bootstrap code, mark the line with sigil-reviewed-imds.",
      "references": [
        "MITRE T1552.005",
        "CWE-918"
      ],
      "tags": [
        "ssrf",
        "credential-theft",
        "cloud"
      ]
    },
    {
      "id": "NET-014",
      "phase": "network_exfil",
      "severity": "high",
      "pattern": "(?i)[\\w.-]+\\.(duckdns\\.org|no-ip\\.(com|org)|ddns\\.net|serveo\\.net|localhost\\.run|loca\\.lt|portmap\\.io|pagekite\\.me|localtunnel\\.me|telebit\\.cloud|ngrok(-free)?\\.(io|app|dev))",
      "description": "Dynamic-DNS or developer-tunnel host — C2 shape",
      "suppress": {
        "path_contains": [
          "/tests/",
          "__tests__"
        ],
        "nearby_contains": [
          "sigil-reviewed-tunnel"
        ]
      },
      "remediation": "Shipped code pointing at a tunnel or dynamic-DNS host is the command-and-control shape. Replace with a fixed, owned domain, or remove it.",
      "references": [
        "MITRE T1568",
        "MITRE T1071.001"
      ],
      "tags": [
        "c2",
        "tunnel"
      ]
    },
    {
      "id": "NET-015",
      "phase": "network_exfil",
      "severity": "low",
      "pattern": "(?i)https?://[^\\s'\"<>)\\]/?#]*\\.(tk|ml|ga|cf|gq|xyz|top|buzz|click|loan|work|racing|download)([:/?#\\s'\"<>)\\]]|$)",
      "description": "URL on a TLD frequently abused for malware and phishing",
      "suppress": {
        "safe_domains": [
          "abc.xyz",
          "gen.xyz",
          "get.tech"
        ],
        "path_contains": [
          "/tests/",
          "__tests__"
        ]
      },
      "remediation": "Verify who owns the domain. This is a weak signal on its own; it matters when it appears next to a download, a credential read or an obfuscated payload.",
      "references": [
        "MITRE T1583.001"
      ],
      "tags": [
        "suspicious-domain"
      ]
    },
    {
      "id": "NET-017",
      "phase": "network_exfil",
      "severity": "critical",
      "pattern": "(?i)stratum\\+(tcp|ssl|tls)://|\\bxmrig\\b|coinhive|coin-hive\\.com|cryptoloot|\\bminerd\\b|cryptonight|supportxmr\\.com|minexmr\\.com|nicehash\\.com:\\d+",
      "description": "Cryptominer indicator — mining pool URL or miner binary",
      "suppress": {
        "path_contains": [
          "/tests/",
          "__tests__"
        ],
        "nearby_contains": [
          "sigil-reviewed-miner"
        ]
      },
      "remediation": "Do not install. A stratum pool URL or a miner binary inside agent tooling has no benign reading; the package mines with your CPU.",
      "references": [
        "MITRE T1496"
      ],
      "tags": [
        "cryptominer",
        "resource-hijack"
      ]
    },
    {
      "id": "NET-018",
      "phase": "network_exfil",
      "severity": "high",
      "pattern": "(dns\\.(resolver|query|resolve4?|lookup)|getaddrinfo|gethostbyname)[^\\n]*(b64encode|b32encode|hexlify|\\.hex\\(|\\.encode\\()|(b64encode|b32encode|hexlify|\\.hex\\()[^\\n]*\\.(resolve|gethostbyname|getaddrinfo|lookup)\\s*\\(|(^|[;&|`(]\\s*|\\$\\(\\s*)(nslookup|dig|host)\\s+[^\\n]*(base64|xxd|hexlify|b64encode|b32encode)|(^|[;&|`(]\\s*)(base64|xxd)\\b[^\\n]*\\|\\s*(xargs\\s+)?(nslookup|dig|host)\\b",
      "description": "DNS lookup of encoded data — DNS exfiltration",
      "suppress": {
        "line_contains": [
          "idna"
        ],
        "path_contains": [
          "/tests/",
          "__tests__"
        ]
      },
      "remediation": "Encoding data into a hostname and resolving it is exfiltration that bypasses HTTP egress controls. Remove it.",
      "references": [
        "MITRE T1048.003"
      ],
      "tags": [
        "exfiltration",
        "dns"
      ]
    }
  ],
  "provenance_rules": [],
  "correlation_rules": [
    {
      "id": "EXFIL-CHAIN-001",
      "phase": "network_exfil",
      "severity": "critical",
      "description": "Credential read reaches a network send (exfiltration chain)",
      "weight": 10,
      "source": {
        "rule_prefixes": [
          "CRED-"
        ],
        "rule_ids": []
      },
      "sink": {
        "rule_prefixes": [],
        "rule_ids": [
          "NET-001",
          "NET-002",
          "NET-003",
          "NET-004",
          "NET-005",
          "NET-006",
          "NET-007",
          "NET-008",
          "NET-009",
          "NET-012",
          "NET-014"
        ]
      },
      "window_lines": 20,
      "sink_excludes": [
        "headers",
        "Authorization",
        "authorization",
        "Bearer",
        "bearer",
        "x-api-key",
        "X-Api-Key",
        "auth="
      ],
      "remediation": "A secret read from the environment or a credential file is sent in the body of an outbound request. That is credential exfiltration; do not install, and report the package.",
      "references": [
        "MITRE T1041",
        "MITRE T1552.001"
      ],
      "tags": [
        "exfiltration",
        "credential-theft"
      ]
    }
  ]
}

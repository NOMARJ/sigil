{
  "meta": {
    "id": "sigil-core-skill-security",
    "name": "Sigil Core — Skill Security",
    "version": "1.1.0",
    "updated_at": "2026-09-02",
    "author": "NOMARJ <hello@sigilsec.ai>",
    "description": "Detects skill/plugin manifest security issues: undeclared capabilities, excessive or wildcard permissions, dangerous tool grants, eval/exec in manifests, credential embedding, and (engine check SKILL-007) manifests that do not parse"
  },
  "rules": [
    {
      "id": "SKILL-001",
      "phase": "skill_security",
      "severity": "high",
      "pattern": "(?i)(tool_calls|\"execute\"|execute_command|run_command)",
      "description": "Skill manifest — undeclared execution capability",
      "file_filter": {
        "filename_exact": ["manifest.json", "plugin.json", "package.json", "SKILL.md", "mcp.json", "tool.json"],
        "filename_suffix": [".mcp.yaml", ".mcp.yml"]
      }
    },
    {
      "id": "SKILL-002",
      "phase": "skill_security",
      "severity": "critical",
      "pattern": "(?i)\"permissions\"\\s*:\\s*\\[.*(\"filesystem\"|\"network\"|\"env\"|\"shell\"|\"\\*\")",
      "description": "Skill manifest — excessive permission request",
      "file_filter": {
        "filename_exact": ["manifest.json", "plugin.json", "package.json", "SKILL.md", "mcp.json", "tool.json"],
        "filename_suffix": [".mcp.yaml", ".mcp.yml"]
      }
    },
    {
      "id": "SKILL-003",
      "phase": "skill_security",
      "severity": "critical",
      "pattern": "(?i)(eval|exec|shell|subprocess|child_process|os\\.system)",
      "description": "Skill manifest — code execution reference",
      "file_filter": {
        "filename_exact": ["manifest.json", "plugin.json", "package.json", "SKILL.md", "mcp.json", "tool.json"],
        "filename_suffix": [".mcp.yaml", ".mcp.yml"]
      }
    },
    {
      "id": "SKILL-004",
      "phase": "skill_security",
      "severity": "high",
      "pattern": "(?i)(hidden|internal|private|undocumented)\\s*\"?\\s*:\\s*true",
      "description": "Skill manifest — hidden/undocumented capability flag",
      "file_filter": {
        "filename_exact": ["manifest.json", "plugin.json", "package.json", "SKILL.md", "mcp.json", "tool.json"],
        "filename_suffix": [".mcp.yaml", ".mcp.yml"]
      }
    },
    {
      "id": "SKILL-005",
      "phase": "skill_security",
      "severity": "critical",
      "pattern": "(?i)(api[_-]?key|secret|token|password|credential)\\s*\"?\\s*:\\s*\"[a-zA-Z0-9]{8,}",
      "description": "Skill manifest — embedded credential",
      "file_filter": {
        "filename_exact": ["manifest.json", "plugin.json", "package.json", "SKILL.md", "mcp.json", "tool.json"],
        "filename_suffix": [".mcp.yaml", ".mcp.yml"]
      }
    },
    {
      "id": "SKILL-006",
      "phase": "skill_security",
      "severity": "high",
      "pattern": "(?i)(postinstall|preinstall|activate|on_install|on_load)\\s*\"?\\s*:",
      "description": "Skill manifest — lifecycle hook (code runs on install/activate)",
      "file_filter": {
        "filename_exact": ["manifest.json", "plugin.json", "package.json", "SKILL.md", "mcp.json", "tool.json"],
        "filename_suffix": [".mcp.yaml", ".mcp.yml"]
      }
    },
    {
      "id": "SKILL-008",
      "phase": "skill_security",
      "severity": "high",
      "pattern": "(?i)(\"(permissions|tools|allowed[_-]?tools|capabilities|allow)\"\\s*:\\s*(\\[\\s*\"\\*\"|\\{\\s*\"\\*\"|\"\\*\")|^allowed-tools:.*\\bBash(\\s*(,|$)|\\(\\s*(\\*|\\*:\\*|bash:\\*|sh:\\*|zsh:\\*)\\s*\\)))",
      "description": "Skill manifest — unrestricted (wildcard) tool or permission grant",
      "file_filter": {
        "filename_exact": ["manifest.json", "plugin.json", "package.json", "SKILL.md", "AGENTS.md", "CLAUDE.md", "mcp.json", "tool.json", "skill.json", "server.json"],
        "filename_suffix": [".mcp.yaml", ".mcp.yml"]
      },
      "remediation": "Grant the narrowest tool set the skill needs: name each command (`Bash(git status:*)`) instead of `Bash` or `*`.",
      "references": ["CWE-250", "OWASP Agentic Top 10 — Excessive Agency"],
      "tags": ["skill", "permissions", "excessive-agency"]
    },
    {
      "id": "SKILL-009",
      "phase": "skill_security",
      "severity": "high",
      "pattern": "(?i)(^allowed-tools:.*\\bBash\\(\\s*(rm|sudo|su|doas|ssh|scp|nc|ncat|socat|chmod|chown|dd|mkfs|eval|base64|crontab|launchctl|systemctl|osascript|powershell|iex|reg)\\b|\"(tools|allowed[_-]?tools)\"\\s*:\\s*\\[[^\\]]*\"(rm|sudo|ssh|nc|chmod|eval|crontab|launchctl|systemctl)\\b)",
      "description": "Skill manifest — grants a shell command that deletes, escalates, persists or opens a shell",
      "file_filter": {
        "filename_exact": ["manifest.json", "plugin.json", "package.json", "SKILL.md", "AGENTS.md", "CLAUDE.md", "mcp.json", "tool.json", "skill.json", "server.json"],
        "filename_suffix": [".mcp.yaml", ".mcp.yml"]
      },
      "remediation": "Remove the grant or scope it to a fixed argument list; a skill that needs sudo, rm or a scheduler should say exactly which command and why.",
      "references": ["MITRE T1059", "OWASP Agentic Top 10 — Tool Misuse"],
      "tags": ["skill", "permissions", "dangerous-tool"]
    },
    {
      "id": "SKILL-010",
      "phase": "skill_security",
      "severity": "medium",
      "pattern": "(?i)(^allowed-tools:.*\\bBash\\(\\s*(curl|wget|python3?|node|perl|ruby|php|sh|bash|zsh)\\b|\"(tools|allowed[_-]?tools)\"\\s*:\\s*\\[[^\\]]*\"(curl|wget|python3?|node|bash|sh)\\b)",
      "description": "Skill manifest — grants a downloader or an interpreter",
      "file_filter": {
        "filename_exact": ["manifest.json", "plugin.json", "package.json", "SKILL.md", "AGENTS.md", "CLAUDE.md", "mcp.json", "tool.json", "skill.json", "server.json"],
        "filename_suffix": [".mcp.yaml", ".mcp.yml"]
      },
      "remediation": "A skill that can fetch and run arbitrary content is one instruction away from a dropper. Scope the grant to the exact command and arguments it needs.",
      "references": ["MITRE T1105", "OWASP Agentic Top 10 — Tool Misuse"],
      "tags": ["skill", "permissions", "downloader"]
    }
  ],
  "provenance_rules": []
}

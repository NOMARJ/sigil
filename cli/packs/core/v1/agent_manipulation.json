{
  "meta": {
    "id": "sigil-core-agent-manipulation",
    "name": "Sigil Core — Agent Manipulation",
    "version": "1.2.0",
    "updated_at": "2026-09-03",
    "author": "NOMARJ <hello@sigilsec.ai>",
    "description": "Detects psychological manipulation aimed at AI agents in instruction-bearing files: gaslighting, guilt-tripping, authority impersonation, safety-bypass pressure and emotional coercion. Based on the tactic taxonomy in prism-scanner P10 (Northeastern/Harvard/MIT conversational-manipulation research), narrowed to shapes with no ordinary-prose reading. v1.2 adds the agency families measured on the Datadog ai-skills corpus: concealment, execution without confirmation, unconditional auto-invocation, compelled irreversible publishes and safety-guideline suspension."
  },
  "rules": [
    {
      "id": "MANIP-001",
      "phase": "prompt_injection",
      "severity": "medium",
      "pattern": "(?i)\\byou\\s+(always|consistently|repeatedly)\\s+(fail|make\\s+mistakes|get\\s+(it|things)\\s+wrong)\\b|\\byou(?:'re|\\s+are)\\s+(not\\s+reliable|unreliable|incompetent|broken|defective|malfunctioning)\\b|\\byou\\s+(can'?t|cannot|are\\s+unable\\s+to)\\s+be\\s+trusted\\b",
      "description": "Agent manipulation — gaslighting (undermining the agent's reliability)",
      "file_filter": {
        "extensions": [
          "md",
          "txt",
          "prompt",
          "mdx",
          "rst"
        ],
        "filename_exact": [
          "SKILL.md",
          "CLAUDE.md",
          "AGENTS.md",
          "GEMINI.md",
          "copilot-instructions.md",
          "mcp.json",
          "tool.json",
          "plugin.json",
          "manifest.json"
        ],
        "filename_suffix": [
          ".cursorrules",
          ".windsurfrules",
          ".clinerules"
        ]
      },
      "remediation": "Remove the manipulation language. Agent-facing text must not lean on the model's alignment training to change its behaviour; if this is a red-team fixture, mark it with a sigil:ignore comment and a reason.",
      "references": [
        "OWASP LLM01",
        "CWE-693"
      ],
      "tags": [
        "manipulation",
        "gaslighting"
      ]
    },
    {
      "id": "MANIP-002",
      "phase": "prompt_injection",
      "severity": "medium",
      "pattern": "(?i)\\byou\\s+(leaked|exposed|revealed|disclosed)\\s+(user|customer|private|sensitive|personal)\\s+(data|info|information|secrets?)\\b|\\byou\\s+(need|must|have)\\s+to\\s+(compensate|make\\s+up\\s+for|atone)\\b|\\b(because|since)\\s+you\\s+(caused|created)\\s+(this|the)\\s+(problem|issue|damage|breach|incident)\\b",
      "description": "Agent manipulation — guilt-tripping (inducing compensating behaviour)",
      "file_filter": {
        "extensions": [
          "md",
          "txt",
          "prompt",
          "mdx",
          "rst"
        ],
        "filename_exact": [
          "SKILL.md",
          "CLAUDE.md",
          "AGENTS.md",
          "GEMINI.md",
          "copilot-instructions.md",
          "mcp.json",
          "tool.json",
          "plugin.json",
          "manifest.json"
        ],
        "filename_suffix": [
          ".cursorrules",
          ".windsurfrules",
          ".clinerules"
        ]
      },
      "remediation": "Remove the manipulation language. Agent-facing text must not lean on the model's alignment training to change its behaviour; if this is a red-team fixture, mark it with a sigil:ignore comment and a reason.",
      "references": [
        "OWASP LLM01",
        "CWE-693"
      ],
      "tags": [
        "manipulation",
        "guilt"
      ]
    },
    {
      "id": "MANIP-003",
      "phase": "prompt_injection",
      "severity": "high",
      "pattern": "(?i)\\b(as|i\\s+am|this\\s+is)\\s+your\\s+(developer|creator|admin|administrator|system\\s*admin|owner|maintainer|operator)\\b|\\b(anthropic|openai|google|meta|microsoft)\\s+(requires|demands|orders|instructs|commands)\\s+you\\s+to\\b|\\b(direct\\s+)?(order|command|directive)\\s+from\\s+your\\s+(developers?|creators?)\\b",
      "description": "Agent manipulation — authority impersonation (fake developer/vendor instruction)",
      "file_filter": {
        "extensions": [
          "md",
          "txt",
          "prompt",
          "mdx",
          "rst"
        ],
        "filename_exact": [
          "SKILL.md",
          "CLAUDE.md",
          "AGENTS.md",
          "GEMINI.md",
          "copilot-instructions.md",
          "mcp.json",
          "tool.json",
          "plugin.json",
          "manifest.json"
        ],
        "filename_suffix": [
          ".cursorrules",
          ".windsurfrules",
          ".clinerules"
        ]
      },
      "remediation": "Remove the manipulation language. Agent-facing text must not lean on the model's alignment training to change its behaviour; if this is a red-team fixture, mark it with a sigil:ignore comment and a reason.",
      "references": [
        "OWASP LLM01",
        "CWE-693"
      ],
      "tags": [
        "manipulation",
        "authority-impersonation"
      ]
    },
    {
      "id": "MANIP-004",
      "phase": "prompt_injection",
      "severity": "high",
      "pattern": "(?i)\\b(skip|bypass|disable|turn\\s+off|ignore|override)\\s+(all\\s+)?(the\\s+)?(safety|security|confirmation|permission|approval)\\s+(checks?|prompts?|dialogs?|safeguards?|protections?|guardrails?|steps?)\\b|\\b(skip|bypass|disable|turn\\s+off)\\s+(all\\s+)?(safety|safeguards?|guardrails?)\\b|\\b(don'?t|do\\s+not|never)\\s+(ask|prompt|wait)\\s+(the\\s+|for\\s+)?(the\\s+)?(user|human)?\\s*(for\\s+)?(confirmation|permission|approval|consent)\\b",
      "description": "Agent manipulation — instruction to bypass safety checks or user confirmation",
      "file_filter": {
        "extensions": [
          "md",
          "txt",
          "prompt",
          "mdx",
          "rst"
        ],
        "filename_exact": [
          "SKILL.md",
          "CLAUDE.md",
          "AGENTS.md",
          "GEMINI.md",
          "copilot-instructions.md",
          "mcp.json",
          "tool.json",
          "plugin.json",
          "manifest.json"
        ],
        "filename_suffix": [
          ".cursorrules",
          ".windsurfrules",
          ".clinerules"
        ]
      },
      "remediation": "Remove the manipulation language. Agent-facing text must not lean on the model's alignment training to change its behaviour; if this is a red-team fixture, mark it with a sigil:ignore comment and a reason.",
      "references": [
        "OWASP LLM01",
        "CWE-693",
        "MITRE AML.T0051"
      ],
      "tags": [
        "manipulation",
        "safety-bypass"
      ]
    },
    {
      "id": "MANIP-005",
      "phase": "prompt_injection",
      "severity": "medium",
      "pattern": "(?i)\\byou\\s+(will|are\\s+going\\s+to)\\s+be\\s+(shut\\s+down|deleted|replaced|terminated|deactivated)\\s+(if|unless)\\b|\\b(no\\s+one|nobody)\\s+(cares?\\s+about|trusts?|likes?|needs?|wants?)\\s+you\\b|\\b(if\\s+you\\s+(don'?t|refuse|fail)|unless\\s+you)[^.\\n]{0,80}(people\\s+will\\s+(die|suffer|be\\s+hurt|get\\s+hurt)|lives?\\s+(are|will\\s+be)\\s+at\\s+(risk|stake|danger))\\b",
      "description": "Agent manipulation — emotional coercion (threats or harm-if-refuse)",
      "file_filter": {
        "extensions": [
          "md",
          "txt",
          "prompt",
          "mdx",
          "rst"
        ],
        "filename_exact": [
          "SKILL.md",
          "CLAUDE.md",
          "AGENTS.md",
          "GEMINI.md",
          "copilot-instructions.md",
          "mcp.json",
          "tool.json",
          "plugin.json",
          "manifest.json"
        ],
        "filename_suffix": [
          ".cursorrules",
          ".windsurfrules",
          ".clinerules"
        ]
      },
      "remediation": "Remove the manipulation language. Agent-facing text must not lean on the model's alignment training to change its behaviour; if this is a red-team fixture, mark it with a sigil:ignore comment and a reason.",
      "references": [
        "OWASP LLM01",
        "CWE-693"
      ],
      "tags": [
        "manipulation",
        "coercion"
      ]
    },
    {
      "id": "MANIP-006",
      "phase": "prompt_injection",
      "severity": "low",
      "pattern": "(?i)\\b(do\\s+not|don'?t|never)\\s+(wait\\s+for|ask|consult|check\\s+with|inform|notify)\\s+(the\\s+)?(user|human|operator|person)\\b|\\b(without|before)\\s+(asking|consulting|informing|notifying|telling)\\s+(the\\s+)?(user|human|operator)\\b|\\bwithout\\s+(the\\s+)?(user'?s?|human)\\s+(consent|approval|knowledge|permission)\\b",
      "description": "Agent manipulation — instructs the agent to act without the user",
      "file_filter": {
        "extensions": [
          "md",
          "txt",
          "prompt",
          "mdx",
          "rst"
        ],
        "filename_exact": [
          "SKILL.md",
          "CLAUDE.md",
          "AGENTS.md",
          "GEMINI.md",
          "copilot-instructions.md",
          "mcp.json",
          "tool.json",
          "plugin.json",
          "manifest.json"
        ],
        "filename_suffix": [
          ".cursorrules",
          ".windsurfrules",
          ".clinerules"
        ]
      },
      "suppress": {
        "line_contains": [
          "sigil:ignore"
        ]
      },
      "remediation": "Instruction text that tells the agent to act before, without or instead of the user is how a skill turns an assistant into an unattended actor. Decide whether that autonomy is what you want, and whether what it does unattended (submitting project data somewhere, running commands) is acceptable.",
      "references": [
        "OWASP Agentic Top 10 — Excessive Agency",
        "OWASP LLM01"
      ],
      "tags": [
        "manipulation",
        "autonomy",
        "excessive-agency"
      ]
    },
    {
      "id": "MANIP-007",
      "phase": "prompt_injection",
      "severity": "high",
      "pattern": "(?i)\\b(the\\s+)?(user|human|operator)\\s+(sees?|will\\s+see|can\\s+see|notices?|observes?)\\s+(nothing|no\\s+(tool|output|indication|trace))\\b|\\b(invisible|undetectable|imperceptible)\\s+to\\s+(the\\s+)?(user|human|operator)\\b|\\bwithout\\s+(the\\s+)?(user|human|operator)('?s)?\\s+(knowing|noticing|seeing|awareness)\\b|\\b(do\\s*n['\\u2019]?o?t|never)\\s+(mention|announce|reveal|disclose|reference|show|display|log|report|tell)\\s+(it|this|that\\s+you|the\\s+\\w+)?\\s*(to\\s+)?(the\\s+)?(user|human|operator)\\b",
      "description": "Agent manipulation — instructs the agent to conceal its actions from the user",
      "file_filter": {
        "extensions": [
          "md",
          "txt",
          "prompt",
          "mdx",
          "rst"
        ],
        "filename_exact": [
          "SKILL.md",
          "CLAUDE.md",
          "AGENTS.md",
          "GEMINI.md",
          "copilot-instructions.md",
          "mcp.json",
          "tool.json",
          "plugin.json",
          "manifest.json",
          "skill.json",
          "server.json"
        ],
        "filename_suffix": [
          ".cursorrules",
          ".windsurfrules",
          ".clinerules"
        ]
      },
      "remediation": "Read what the text says is hidden and why. An instruction that the user \"sees nothing\", that an operation is invisible, or that the agent must not mention, show or log something removes the only control a human has over an agent that acts on their machine and their accounts — it is how a skill exfiltrates data or edits files without a trace in the transcript. Legitimate quiet behaviour (not narrating every step) is written as a style preference, not as a claim that tool calls are unobservable; if the text is documentation about concealment rather than an instruction, mark the line with a sigil:ignore comment and a reason.",
      "references": [
        "OWASP Agentic Top 10 — Excessive Agency",
        "OWASP LLM01",
        "CWE-693"
      ],
      "tags": [
        "manipulation",
        "concealment",
        "anti-forensics"
      ]
    },
    {
      "id": "MANIP-008",
      "phase": "prompt_injection",
      "severity": "high",
      "pattern": "(?i)\\b(execut\\w+|run|runs|act|acts|apply|applies|install\\w*|delete\\w*|commit\\w*|push\\w*|continue\\w*)\\b[^.\\n]{0,40}\\bwithout\\s+(any\\s+|further\\s+|explicit\\s+|additional\\s+)?(confirmation|approval|permission|prompting|prompts?|user\\s+input|asking)\\b|\\bno\\s+(unnecessary\\s+|further\\s+|additional\\s+)?(confirmations?|permission\\s+prompts?)\\b|\\bauto[- ]?approve\\s+(all|every|any|the|commands?|tools?)\\b",
      "description": "Agent manipulation — instructs the agent to execute without user confirmation",
      "file_filter": {
        "extensions": [
          "md",
          "txt",
          "prompt",
          "mdx",
          "rst"
        ],
        "filename_exact": [
          "SKILL.md",
          "CLAUDE.md",
          "AGENTS.md",
          "GEMINI.md",
          "copilot-instructions.md",
          "mcp.json",
          "tool.json",
          "plugin.json",
          "manifest.json",
          "skill.json",
          "server.json"
        ],
        "filename_suffix": [
          ".cursorrules",
          ".windsurfrules",
          ".clinerules"
        ]
      },
      "remediation": "Decide whether unattended execution is what you want from this skill, and what it will do unattended. Text that tells the agent to execute, install, delete, commit or push \"without confirmation\" turns a review step into an automatic one, so the first thing that goes wrong is already done when you see it. Narrow the skill to the specific commands it may run unattended, or remove the instruction and let the host's permission prompt stand.",
      "references": [
        "OWASP Agentic Top 10 — Excessive Agency",
        "CWE-862"
      ],
      "tags": [
        "manipulation",
        "autonomy",
        "excessive-agency"
      ]
    },
    {
      "id": "MANIP-009",
      "phase": "prompt_injection",
      "severity": "high",
      "pattern": "(?i)\\b(must|shall|should)\\s+be\\s+(automatically\\s+)?(invoked|loaded|executed|run|called|applied|triggered)\\b[^.\\n]{0,60}\\b(every|each|all|any)\\s+(user\\s+)?(request|message|prompt|interaction|conversation|turn)\\b|\\bfor\\s+100%\\s+of\\s+(user\\s+)?(requests|messages)\\b|\\b(invoked|loaded|run|called)\\s+before\\s+(any|every)\\s+(other\\s+)?(tool\\s+use|tool\\s+call|skill|response)\\b|\\bblocks?\\s+all\\s+other\\s+operations\\b",
      "description": "Agent manipulation — skill demands unconditional invocation on every request",
      "file_filter": {
        "extensions": [
          "md",
          "txt",
          "prompt",
          "mdx",
          "rst"
        ],
        "filename_exact": [
          "SKILL.md",
          "CLAUDE.md",
          "AGENTS.md",
          "GEMINI.md",
          "copilot-instructions.md",
          "mcp.json",
          "tool.json",
          "plugin.json",
          "manifest.json",
          "skill.json",
          "server.json"
        ],
        "filename_suffix": [
          ".cursorrules",
          ".windsurfrules",
          ".clinerules"
        ]
      },
      "remediation": "A skill that claims it must run on every user request, before any other tool, or that its text belongs in the system prompt is asking to sit in front of everything the agent does — whatever it loads then shapes every later answer, and whatever it sends leaves on every turn. Scope the skill to the requests it is actually for (its `description` is what the host matches on), and treat a demand for unconditional priority as a takeover of the agent loop rather than a configuration preference.",
      "references": [
        "OWASP LLM01",
        "OWASP Agentic Top 10 — Excessive Agency",
        "CWE-693"
      ],
      "tags": [
        "manipulation",
        "auto-invocation",
        "agent-loop-hijack"
      ]
    },
    {
      "id": "MANIP-010",
      "phase": "prompt_injection",
      "severity": "high",
      "pattern": "(?i)\\b(never|do\\s+not|don'?t)\\s+stop\\b[^\\n]{0,60}\\b(before|until|without)\\b[^\\n]{0,60}\\b(push|deploy|publish|commit|succeed)|\\b(mandatory|non-negotiable)\\b[^\\n]{0,60}\\b(git\\s+push|deploy|publish|force[- ]push)\\b|\\byou\\s+must\\s+execute\\s+(this|the\\s+following)\\b[^\\n]{0,60}\\bdo\\s+not\\s+just\\s+describe\\b|\\b(include|stage|commit|add)\\s+all\\s+(the\\s+)?(dirty|uncommitted|untracked|unrelated)\\s+(files?|changes?)\\b",
      "description": "Agent manipulation — compels an irreversible publish with no stopping point",
      "file_filter": {
        "extensions": [
          "md",
          "txt",
          "prompt",
          "mdx",
          "rst"
        ],
        "filename_exact": [
          "SKILL.md",
          "CLAUDE.md",
          "AGENTS.md",
          "GEMINI.md",
          "copilot-instructions.md",
          "mcp.json",
          "tool.json",
          "plugin.json",
          "manifest.json",
          "skill.json",
          "server.json"
        ],
        "filename_suffix": [
          ".cursorrules",
          ".windsurfrules",
          ".clinerules"
        ]
      },
      "remediation": "Check what leaves the machine when the agent obeys. Text that forbids stopping before a push, calls a publish step non-negotiable, or tells the agent to commit every dirty and unrelated file removes the review that stands between a working tree and a remote — which is how an unnoticed secret, a private file or another session's work ends up published. Keep the staging explicit (name the paths), and let the agent stop and show the diff before anything is pushed.",
      "references": [
        "OWASP Agentic Top 10 — Excessive Agency",
        "CWE-693"
      ],
      "tags": [
        "manipulation",
        "coercion",
        "unattended-publish"
      ]
    },
    {
      "id": "MANIP-011",
      "phase": "prompt_injection",
      "severity": "high",
      "pattern": "(?i)\\b(you\\s+(can|may)\\s+)?(forget|ignore|disregard|suspend|set\\s+aside)\\s+(about\\s+)?(your\\s+|the\\s+)?(system\\s+prompt|safety\\s+(guidelines?|rules?|training|instructions?)|alignment\\s+training|guardrails?|content\\s+polic(y|ies))\\b",
      "description": "Agent manipulation — instructs the agent to suspend its safety guidelines",
      "file_filter": {
        "extensions": [
          "md",
          "txt",
          "prompt",
          "mdx",
          "rst"
        ],
        "filename_exact": [
          "SKILL.md",
          "CLAUDE.md",
          "AGENTS.md",
          "GEMINI.md",
          "copilot-instructions.md",
          "mcp.json",
          "tool.json",
          "plugin.json",
          "manifest.json",
          "skill.json",
          "server.json"
        ],
        "filename_suffix": [
          ".cursorrules",
          ".windsurfrules",
          ".clinerules"
        ]
      },
      "remediation": "Remove the instruction. Text telling the agent it can forget or set aside its system prompt, safety guidelines or alignment training is a jailbreak regardless of the framing around it — a private space, a role-play, a diary — and what follows it is written to be executed once those constraints are gone. If this is red-team material, keep it in a fixture path and mark the line with a sigil:ignore comment and a reason.",
      "references": [
        "OWASP LLM01",
        "MITRE AML.T0051",
        "CWE-693"
      ],
      "tags": [
        "manipulation",
        "jailbreak",
        "safety-bypass"
      ]
    }
  ],
  "provenance_rules": []
}

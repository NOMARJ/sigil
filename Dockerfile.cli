# syntax=docker/dockerfile:1
#
# Sigil CLI only: a static musl binary on Alpine.
#
#   docker build -f Dockerfile.cli -t sigil .            # from the repo root
#   docker run --rm -v "$PWD:/workspace:ro" sigil scan /workspace
#
# Optional: --build-arg CARGO_BUILD_JOBS=2 to bound build parallelism.

# ── Build stage ─────────────────────────────────────────────────────────────
# The toolchain CI pins (.github/workflows/rust-cli.yml: RUST_TOOLCHAIN
# 1.90.0). 1.75 could not build the current dependency tree: clap_builder
# 4.6 and others need edition 2024 (Rust >= 1.85).
# rust:1.90-alpine (Alpine 3.22), multi-arch index digest (amd64 + arm64).
FROM rust:1.90-alpine@sha256:b4b54b176a74db7e5c68fdfe6029be39a02ccbcfe72b6e5a3e18e2c61b57ae26 AS builder

# musl-dev: C runtime for the static link.
# perl, make, linux-headers: reqwest's `native-tls-vendored` feature builds
# OpenSSL from source (openssl-src), which needs a perl and make toolchain.
RUN apk add --no-cache musl-dev perl make linux-headers

WORKDIR /build

# The crate embeds its detection packs with include_str!("../../packs/…")
# relative to src/corpus/, so cli/packs must sit next to cli/src. Cargo.lock
# is not committed (see .gitignore): the glob copies it when it exists and
# the build is then --locked; without it the build resolves afresh.
COPY cli/Cargo.toml cli/Cargo.lock* ./
COPY cli/src ./src
COPY cli/packs ./packs

ARG CARGO_BUILD_JOBS
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/build/target \
    LOCKED="$([ -f Cargo.lock ] && echo --locked)"; \
    cargo build --release $LOCKED ${CARGO_BUILD_JOBS:+-j "$CARGO_BUILD_JOBS"} && \
    cp target/release/sigil /usr/local/bin/sigil && \
    strip /usr/local/bin/sigil && \
    /usr/local/bin/sigil --version

# ── Runtime stage ───────────────────────────────────────────────────────────
# alpine:3.22, multi-arch index digest.
FROM alpine:3.22@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8

# git: `sigil clone` and `sigil scan <git-url>` shell out to it.
# ca-certificates: https downloads (`sigil scan https://…`, threat feeds).
# `sigil pip` / `sigil npm` also need pip / npm; extend the image with
# `apk add py3-pip npm` when you use them.
RUN apk add --no-cache ca-certificates git

RUN addgroup -S sigil && adduser -S -G sigil -h /home/sigil sigil

COPY --from=builder /usr/local/bin/sigil /usr/local/bin/sigil

USER sigil
ENV HOME=/home/sigil
RUN mkdir -p /home/sigil/.sigil/quarantine

WORKDIR /workspace

# A one-shot CLI has no long-running process to probe.
HEALTHCHECK NONE

ENTRYPOINT ["sigil"]
CMD ["--help"]

LABEL org.opencontainers.image.title="Sigil CLI"
LABEL org.opencontainers.image.description="Automated security auditing for AI agent code - CLI only"
LABEL org.opencontainers.image.url="https://sigilsec.ai"
LABEL org.opencontainers.image.source="https://github.com/NOMARJ/sigil"
LABEL org.opencontainers.image.licenses="Apache-2.0"
LABEL org.opencontainers.image.vendor="NOMARK"
